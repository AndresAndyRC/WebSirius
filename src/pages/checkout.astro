---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Demo de portafolio | SIRIUS"
  description="Demostración de portafolio — el checkout está deshabilitado."
>
  <div class="checkout-redirect-wrapper">
    <div class="redirect-card glass-layered">
      <div class="demo-badge">Demo de portafolio</div>

      <h1 class="redirect-title">El pago está deshabilitado</h1>
      <p class="redirect-subtitle">
        Este sitio es una <strong>demostración para portafolio</strong>. El catálogo
        y el carrito son funcionales a nivel visual, pero el checkout no procesa
        pagos ni genera pedidos reales.
      </p>

      <div class="redirect-actions">
        <a class="btn btn--primary" href="/colecciones">Seguir explorando el catálogo</a>
        <a class="redirect-back" href="/">Volver al inicio</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .checkout-redirect-wrapper {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: calc(var(--header-height) + 2rem) 1rem 4rem;
  }
  .redirect-card {
    text-align: center;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 3rem 2rem;
    max-width: 480px;
    width: 100%;
  }
  .demo-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #cb9bfa;
    background: rgba(203, 155, 250, 0.1);
    border: 1px solid rgba(203, 155, 250, 0.25);
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    margin: 0 auto 1.25rem;
  }
  .redirect-title {
    color: #fff;
    font-size: 1.4rem;
    margin: 0 0 0.5rem;
  }
  .redirect-subtitle {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.95rem;
    margin: 0 0 1.5rem;
  }
  .redirect-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .redirect-back {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.85rem;
    text-decoration: none;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.2);
  }
  .redirect-back:hover { color: #fff; }
</style>
