---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Redirigiendo al pago seguro | SIRIUS"
  description="Estás siendo redirigido al checkout seguro."
>
  <div class="checkout-redirect-wrapper">
    <div class="redirect-card glass-layered">
      <div class="redirect-spinner" id="spinner"></div>

      <h1 class="redirect-title" id="redirect-title">Preparando tu pago seguro</h1>
      <p class="redirect-subtitle" id="redirect-subtitle">
        Te llevamos al checkout en segundos. No cierres esta ventana.
      </p>

      <p class="redirect-error" id="redirect-error" hidden></p>

      <a class="redirect-back" href="/">Volver al inicio</a>
    </div>
  </div>
</BaseLayout>

<style>
  .checkout-redirect-wrapper {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: calc(var(--header-height) + 2rem) 1rem 4rem;
  }
  .redirect-card {
    text-align: center;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 3rem 2rem;
    max-width: 480px;
    width: 100%;
  }
  .redirect-spinner {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 3px solid rgba(255, 255, 255, 0.1);
    border-top-color: #cb9bfa;
    animation: spin 0.8s linear infinite;
    margin: 0 auto 1.5rem;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  .redirect-title {
    color: #fff;
    font-size: 1.4rem;
    margin: 0 0 0.5rem;
  }
  .redirect-subtitle {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.95rem;
    margin: 0 0 1.5rem;
  }
  .redirect-error {
    color: #ff6b6b;
    background: rgba(255, 107, 107, 0.08);
    border: 1px solid rgba(255, 107, 107, 0.2);
    border-radius: 8px;
    padding: 0.8rem 1rem;
    font-size: 0.9rem;
    margin: 0 0 1.5rem;
  }
  .redirect-back {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.85rem;
    text-decoration: none;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.2);
  }
  .redirect-back:hover { color: #fff; }
</style>

<script>
  import { cartItems } from '../store/cartStore';
  import { createCart } from '../lib/shopify';

  const spinner = document.getElementById('spinner');
  const titleEl = document.getElementById('redirect-title');
  const subtitleEl = document.getElementById('redirect-subtitle');
  const errorEl = document.getElementById('redirect-error');

  function showError(msg: string) {
    if (spinner) spinner.style.display = 'none';
    if (titleEl) titleEl.textContent = 'No pudimos preparar tu pago';
    if (subtitleEl) subtitleEl.textContent = 'Intenta de nuevo en un momento o contáctanos por WhatsApp.';
    if (errorEl) {
      errorEl.textContent = msg;
      errorEl.hidden = false;
    }
  }

  (async () => {
    const items = cartItems.get();

    if (items.length === 0) {
      window.location.href = '/colecciones';
      return;
    }

    const missingVariant = items.find(i => !i.variantId);
    if (missingVariant) {
      showError(
        `El producto "${missingVariant.title}" fue añadido antes de la migración. Quítalo y vuelve a añadirlo desde su página.`,
      );
      return;
    }

    try {
      const lines = items.map(i => ({
        merchandiseId: i.variantId,
        quantity: i.quantity,
      }));
      const { checkoutUrl } = await createCart(lines);
      window.location.href = checkoutUrl;
    } catch (e: any) {
      showError(e?.message || 'Error desconocido al crear el carrito.');
    }
  })();
</script>
