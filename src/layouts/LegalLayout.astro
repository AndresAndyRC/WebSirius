---
/**
 * LegalLayout.astro — Shared shell for legal / policy pages
 *
 * Usado por las 4 páginas de /politicas/*. Aporta el hero, el índice
 * lateral pegajoso, los enlaces cruzados entre políticas y el CTA de
 * contacto. El contenido de cada política llega por <slot /> y se
 * estiliza aquí mediante reglas :global() — así las 4 páginas comparten
 * exactamente el mismo diseño y no necesitan <style> propio.
 *
 * Props:
 *   title        → nombre de la política ("Política de privacidad")
 *   description  → meta description SEO
 *   lastUpdated  → fecha ISO ("2025-10-07"); se formatea a es-CO
 *   emoji        → icono del hero
 *   toc          → [{ id, label }] para el índice lateral; cada id debe
 *                  corresponder a un <section id="..."> del slot
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/layout/Breadcrumbs.astro';

interface TocItem {
  id: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  lastUpdated: string;
  emoji?: string;
  toc?: TocItem[];
}

const { title, description, lastUpdated, emoji = '📄', toc = [] } = Astro.props;

// Fecha ISO → "7 de octubre de 2025"
const lastUpdatedLabel = new Date(`${lastUpdated}T00:00:00`).toLocaleDateString('es-CO', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

// Catálogo único de políticas — fuente de verdad para los enlaces cruzados.
const POLICIES = [
  { label: 'Política de privacidad',   href: '/politicas/privacidad' },
  { label: 'Términos y condiciones',   href: '/politicas/terminos' },
  { label: 'Política de devoluciones', href: '/politicas/devoluciones' },
  { label: 'Política de envíos',       href: '/politicas/envios' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '');
const otherPolicies = POLICIES.filter((p) => p.href !== currentPath);

// Schema.org WebPage — aporta marcado estructurado a las páginas legales.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: new URL(currentPath, Astro.site).toString(),
  inLanguage: 'es-CO',
  dateModified: lastUpdated,
  isPartOf: {
    '@type': 'WebSite',
    name: 'SIRIUS Iluminación',
    url: 'https://siriuscol.com',
  },
};
---

<BaseLayout
  title={`${title} | SIRIUS Iluminación`}
  description={description}
  canonical={currentPath}
  ogType="website"
  jsonLd={jsonLd}
>
  <!-- ══════════════════════════════════════════ HERO ═══════════ -->
  <section class="legal-hero">
    <div class="legal-hero__glow" aria-hidden="true"></div>
    <div class="container legal-hero__inner">
      <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: title }]} />

      <div class="legal-hero__eyebrow">
        <span class="legal-hero__icon" aria-hidden="true">{emoji}</span>
        <span class="tag">Centro Legal</span>
      </div>

      <h1 class="legal-hero__title font-display">{title}</h1>

      <p class="legal-hero__updated">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" />
        </svg>
        Última actualización: <strong>{lastUpdatedLabel}</strong>
      </p>
    </div>
  </section>

  <!-- ══════════════════════════════════════════ BODY ═══════════ -->
  <section class="legal-body section">
    <div class="container legal-grid">
      <!-- ── Sidebar: índice + políticas + ayuda ── -->
      <aside class="legal-aside" aria-label="Navegación de la política">
        {toc.length > 0 && (
          <nav class="legal-toc" aria-label="Índice de contenidos">
            <p class="legal-aside__title">En esta página</p>
            <ul>
              {toc.map((item) => (
                <li><a href={`#${item.id}`} class="legal-toc__link">{item.label}</a></li>
              ))}
            </ul>
          </nav>
        )}

        <div class="legal-relinks">
          <p class="legal-aside__title">Otras políticas</p>
          <ul>
            {otherPolicies.map((p) => (
              <li><a href={p.href} class="legal-relinks__link">{p.label}</a></li>
            ))}
          </ul>
        </div>

        <div class="legal-help glass">
          <span class="legal-help__icon" aria-hidden="true">✦</span>
          <h2 class="legal-help__title">¿Tienes dudas?</h2>
          <p class="legal-help__body">
            Nuestro equipo resuelve cualquier consulta sobre esta política.
          </p>
          <a href="/contacto" class="btn btn--primary legal-help__cta">Contáctanos →</a>
        </div>
      </aside>

      <!-- ── Contenido de la política (slot) ── -->
      <article class="legal-content">
        <slot />
      </article>
    </div>
  </section>

  <!-- ══════════════════════════════════════════ CTA ════════════ -->
  <section class="legal-cta">
    <div class="container legal-cta__inner">
      <div>
        <h2 class="legal-cta__title font-display">¿Preguntas sobre nuestras políticas?</h2>
        <p class="legal-cta__sub">
          Escríbenos y un asesor de SIRIUS te ayudará lo antes posible.
        </p>
      </div>
      <a href="/contacto" class="btn btn--primary legal-cta__btn">Ir a Contacto</a>
    </div>
  </section>
</BaseLayout>

<style>
/* ── Hero ────────────────────────────────────────────────── */
.legal-hero {
  position: relative;
  padding-block: var(--space-12) var(--space-10);
  overflow: hidden;
  background: var(--color-surface-base);
  border-bottom: 1px solid var(--color-surface-border);
}

.legal-hero__glow {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 55% 70% at 25% 0%, rgba(245,166,35,0.12) 0%, transparent 70%);
  pointer-events: none;
}

.legal-hero__inner {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.legal-hero__eyebrow {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-top: var(--space-2);
}

.legal-hero__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  font-size: 1.4rem;
  line-height: 1;
  border-radius: var(--radius-lg);
  background: rgba(245,166,35,0.12);
  border: 1px solid rgba(245,166,35,0.25);
}

.legal-hero__title {
  font-size: var(--text-4xl);
  font-weight: var(--fw-extrabold);
  color: var(--color-text-primary);
  line-height: var(--lh-tight);
  letter-spacing: -0.03em;
  max-width: 20ch;
}

.legal-hero__updated {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  width: fit-content;
  font-size: var(--text-xs);
  color: var(--color-text-tertiary);
  background: var(--color-surface-raised);
  border: 1px solid var(--color-surface-border);
  padding: var(--space-2) var(--space-3);
  border-radius: var(--radius-full);
}
.legal-hero__updated strong { color: var(--color-text-secondary); font-weight: var(--fw-semibold); }

/* ── Body grid ───────────────────────────────────────────── */
.legal-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-10);
  align-items: start;
}

@media (min-width: 980px) {
  .legal-grid {
    grid-template-columns: 260px 1fr;
    gap: var(--space-12);
  }
}

/* ── Sidebar ─────────────────────────────────────────────── */
.legal-aside {
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
}

@media (min-width: 980px) {
  .legal-aside {
    position: sticky;
    top: calc(var(--header-h) + var(--space-6));
  }
}

.legal-aside__title {
  font-family: var(--font-display);
  font-size: var(--text-xs);
  font-weight: var(--fw-semibold);
  color: var(--color-text-tertiary);
  letter-spacing: 0.10em;
  text-transform: uppercase;
  margin-bottom: var(--space-3);
}

/* Índice (TOC) */
.legal-toc ul { display: flex; flex-direction: column; gap: var(--space-1); }

.legal-toc__link {
  display: block;
  padding: var(--space-2) var(--space-3);
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  border-left: 2px solid var(--color-surface-border);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  transition: color var(--duration-fast), border-color var(--duration-fast), background var(--duration-fast);
}
.legal-toc__link:hover {
  color: var(--color-text-primary);
  background: rgba(255,255,255,0.03);
}
.legal-toc__link.is-active {
  color: var(--color-brand-primary);
  border-left-color: var(--color-brand-primary);
  background: var(--color-brand-primary-08);
}

/* Enlaces a otras políticas */
.legal-relinks ul { display: flex; flex-direction: column; gap: var(--space-2); }

.legal-relinks__link {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  transition: color var(--duration-fast);
}
.legal-relinks__link::before {
  content: '›';
  color: var(--color-brand-primary);
  font-weight: var(--fw-bold);
}
.legal-relinks__link:hover { color: var(--color-brand-primary); }

/* Tarjeta de ayuda */
.legal-help {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  padding: var(--space-5);
  border-radius: var(--radius-xl);
}
.legal-help__icon { font-size: var(--text-xl); color: var(--color-brand-primary); }
.legal-help__title {
  font-family: var(--font-display);
  font-size: var(--text-base);
  font-weight: var(--fw-bold);
  color: var(--color-text-primary);
}
.legal-help__body {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  line-height: var(--lh-normal);
}
.legal-help__cta { margin-top: var(--space-2); justify-content: center; }

/* ── Contenido legal (slot) — estilizado con :global ─────── */
.legal-content {
  min-width: 0;
  max-width: 75ch;
}

.legal-content :global(section) {
  scroll-margin-top: calc(var(--header-h) + var(--space-5));
}
.legal-content :global(section + section) {
  margin-top: var(--space-8);
  padding-top: var(--space-8);
  border-top: 1px solid var(--color-surface-divider);
}

.legal-content :global(h2) {
  font-family: var(--font-display);
  font-size: var(--text-2xl);
  font-weight: var(--fw-bold);
  color: var(--color-text-primary);
  line-height: var(--lh-snug);
  letter-spacing: -0.02em;
  margin-bottom: var(--space-4);
  scroll-margin-top: calc(var(--header-h) + var(--space-5));
}

.legal-content :global(h3) {
  font-family: var(--font-display);
  font-size: var(--text-lg);
  font-weight: var(--fw-semibold);
  color: var(--color-text-primary);
  margin-top: var(--space-6);
  margin-bottom: var(--space-3);
}

.legal-content :global(p) {
  font-size: var(--text-base);
  color: var(--color-text-secondary);
  line-height: var(--lh-relaxed);
  margin-bottom: var(--space-4);
}

.legal-content :global(ul),
.legal-content :global(ol) {
  list-style: revert;
  padding-left: var(--space-6);
  margin-bottom: var(--space-4);
  color: var(--color-text-secondary);
}
.legal-content :global(li) {
  font-size: var(--text-base);
  line-height: var(--lh-relaxed);
  margin-bottom: var(--space-2);
}
.legal-content :global(li::marker) { color: var(--color-brand-primary); }

.legal-content :global(strong) {
  color: var(--color-text-primary);
  font-weight: var(--fw-semibold);
}

.legal-content :global(a) {
  color: var(--color-brand-primary);
  text-decoration: underline;
  text-underline-offset: 3px;
  transition: color var(--duration-fast);
}
.legal-content :global(a:hover) { color: var(--color-brand-gold); }

.legal-content :global(:last-child) { margin-bottom: 0; }

/* Bloque destacado opcional para avisos importantes */
.legal-content :global(.legal-note) {
  display: flex;
  gap: var(--space-3);
  padding: var(--space-4) var(--space-5);
  margin: var(--space-5) 0;
  background: var(--color-brand-primary-08);
  border: 1px solid rgba(245,166,35,0.22);
  border-radius: var(--radius-lg);
}
.legal-content :global(.legal-note p) { margin-bottom: 0; }

/* ── CTA inferior ────────────────────────────────────────── */
.legal-cta {
  background: linear-gradient(135deg, rgba(245,166,35,0.08) 0%, rgba(0,194,255,0.06) 100%);
  border-top: 1px solid var(--color-surface-border);
  border-bottom: 1px solid var(--color-surface-border);
  padding-block: var(--space-12);
}

.legal-cta__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-8);
  flex-wrap: wrap;
}

.legal-cta__title {
  font-size: var(--text-2xl);
  font-weight: var(--fw-bold);
  color: var(--color-text-primary);
  letter-spacing: -0.02em;
  margin-bottom: var(--space-1);
}
.legal-cta__sub { font-size: var(--text-sm); color: var(--color-text-secondary); }
.legal-cta__btn { white-space: nowrap; }
</style>

<!-- Scroll-spy: resalta la sección activa en el índice lateral -->
<script>
  const tocLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('.legal-toc__link'),
  );

  if (tocLinks.length > 0) {
    const linkById = new Map(
      tocLinks.map((a) => [a.getAttribute('href')?.slice(1) ?? '', a]),
    );
    const sections = document.querySelectorAll<HTMLElement>('.legal-content section[id]');

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            tocLinks.forEach((l) => l.classList.remove('is-active'));
            linkById.get(entry.target.id)?.classList.add('is-active');
          }
        }
      },
      { rootMargin: '-20% 0px -70% 0px' },
    );

    sections.forEach((section) => observer.observe(section));
  }
</script>
