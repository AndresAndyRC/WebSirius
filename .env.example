# ── Copia este archivo como .env para desarrollo local ───────
# NO subas .env al repositorio (.gitignore ya lo excluye)
# Configura estas mismas variables en:
#   · Vercel   → tu proyecto → Settings → Environment Variables
#   · GitHub   → Settings → Secrets → Actions

# Google Analytics 4 — Measurement ID
# Obtén tu ID en: analytics.google.com → Admin → Data Streams
GOOGLE_ANALYTICS_ID=G-TB3KKLD8HH

# URL pública del sitio (sin trailing slash)
PUBLIC_SITE_URL=https://siriuscol.com

# ── Shopify Storefront API (backend de productos y checkout) ───────
# Obtén el token en: Shopify Admin → Sales channels → Headless → Storefront API → "Public access token"
# IMPORTANTE: NO uses el token de Admin API (los que empiezan con "shpat_").
# El Storefront public token es un string hex/alfanumérico SIN prefijo.
# Nota: Wompi ya no requiere variables aquí — la pasarela vive dentro del
# checkout de Shopify y se configura en Shopify Admin → Settings → Payments.
PUBLIC_SHOPIFY_STORE_DOMAIN=8780ff-2.myshopify.com
PUBLIC_SHOPIFY_STOREFRONT_TOKEN=tu_token_publico_storefront_aqui
PUBLIC_SHOPIFY_API_VERSION=2024-10
